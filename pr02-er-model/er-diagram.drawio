<mxfile host="app.diagrams.net" type="device"><diagram id="library-er" name="ER-модель"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="806" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;ER-модель «Бібліотека коледжу»&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;Концептуальна модель, нотація Crow&#x27;s Foot (Мартіна).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="700" height="50" as="geometry"/></mxCell><mxCell id="author" value="АВТОР" style="swimlane;html=1;fontStyle=1;fontSize=14;startSize=32;collapsible=0;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="112" as="geometry"/></mxCell><mxCell id="author_attrs" value="&lt;u&gt;&lt;b&gt;код автора&lt;/b&gt;&lt;/u&gt;&lt;br&gt;ПІБ (складений)&lt;br&gt;країна" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;whiteSpace=wrap;overflow=hidden;fontSize=13;rotatable=0;" vertex="1" parent="author"><mxGeometry x="0" y="32" width="250" height="80" as="geometry"/></mxCell><mxCell id="authorship" value="АВТОРСТВО" style="swimlane;html=1;fontStyle=1;fontSize=14;startSize=32;collapsible=0;rounded=1;arcSize=2;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="250" height="112" as="geometry"/></mxCell><mxCell id="authorship_attrs" value="порядковий номер&lt;br&gt;роль&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:12px&quot;&gt;(ідентифікується книгою й автором)&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;whiteSpace=wrap;overflow=hidden;fontSize=13;rotatable=0;" vertex="1" parent="authorship"><mxGeometry x="0" y="32" width="250" height="80" as="geometry"/></mxCell><mxCell id="book" value="КНИГА" style="swimlane;html=1;fontStyle=1;fontSize=14;startSize=32;collapsible=0;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="280" height="222" as="geometry"/></mxCell><mxCell id="book_attrs" value="&lt;u&gt;&lt;b&gt;код книги&lt;/b&gt;&lt;/u&gt;&lt;br&gt;ISBN (унікальний)&lt;br&gt;назва&lt;br&gt;рік видання&lt;br&gt;видавництво&lt;br&gt;кількість сторінок&lt;br&gt;розділ&lt;br&gt;&lt;font color=&quot;#444444&quot;&gt;/кількість вільних примірників&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;whiteSpace=wrap;overflow=hidden;fontSize=13;rotatable=0;" vertex="1" parent="book"><mxGeometry x="0" y="32" width="280" height="190" as="geometry"/></mxCell><mxCell id="reader" value="ЧИТАЧ" style="swimlane;html=1;fontStyle=1;fontSize=14;startSize=32;collapsible=0;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="250" height="200" as="geometry"/></mxCell><mxCell id="reader_attrs" value="&lt;u&gt;&lt;b&gt;номер квитка&lt;/b&gt;&lt;/u&gt;&lt;br&gt;ПІБ (складений)&lt;br&gt;категорія&lt;br&gt;група&lt;br&gt;телефон&lt;br&gt;e-mail&lt;br&gt;дата реєстрації" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;whiteSpace=wrap;overflow=hidden;fontSize=13;rotatable=0;" vertex="1" parent="reader"><mxGeometry x="0" y="32" width="250" height="168" as="geometry"/></mxCell><mxCell id="loan" value="ВИДАЧА" style="swimlane;html=1;fontStyle=1;fontSize=14;startSize=32;collapsible=0;rounded=1;arcSize=2;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;strokeWidth=1.6;" vertex="1" parent="1">